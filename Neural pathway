<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeuralPath | AI Career Intelligence</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-dark: #02060c;
            --accent-cyan: #00ccff;
            --accent-blue: #0077ff;
            --text-main: #e6f1ff;
            --text-dim: #8892b0;
            --glass: rgba(10, 25, 47, 0.95);
            --border-glow: 1px solid rgba(0, 204, 255, 0.2);
            --btn-grad: linear-gradient(90deg, #0077ff, #00ccff);
            --error-red: #ff4466;
            --success-green: #00ff88;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
        
        body { 
            background-color: var(--bg-dark);
            background-image: radial-gradient(circle at 50% 50%, #0a192f 0%, #02060c 100%);
            color: var(--text-main);
            min-height: 100vh;
            line-height: 1.6;
            overflow-x: hidden;
        }

        .bg-grid {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: linear-gradient(rgba(0, 204, 255, 0.02) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(0, 204, 255, 0.02) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
        }

        .hidden { display: none !important; }

        /* NOTIFICATIONS */
        .success-toast {
            position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
            background: rgba(2, 6, 12, 0.98); border: 2px solid var(--accent-cyan);
            backdrop-filter: blur(20px); padding: 50px; border-radius: 12px;
            text-align: center; z-index: 9999; box-shadow: 0 0 60px rgba(0, 204, 255, 0.3);
            width: 90%; max-width: 450px; animation: popIn 0.5s cubic-bezier(0.26, 1.36, 0.74, 1.2) forwards;
        }

        @keyframes popIn {
            0% { opacity: 0; transform: translate(-50%, -60%) scale(0.9); }
            100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        }

        /* GLASS CARD & UI */
        .glass-card {
            background: var(--glass); border: var(--border-glow);
            backdrop-filter: blur(20px); padding: 40px; border-radius: 12px;
            width: 100%; max-width: 480px; box-shadow: 0 0 50px rgba(0,0,0,0.5);
        }

        .input-group { position: relative; margin-bottom: 20px; }
        .input-box {
            width: 100%; padding: 16px; background: rgba(0,0,0,0.4);
            border: 1px solid rgba(0, 204, 255, 0.1); color: white; border-radius: 8px; outline: none; transition: 0.3s;
        }
        .input-box:focus { border-color: var(--accent-cyan); }
        
        .eye-icon { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); cursor: pointer; color: var(--accent-cyan); }

        .btn-grad {
            background: var(--btn-grad); color: white; padding: 18px; border-radius: 8px;
            border: none; font-weight: 800; cursor: pointer; text-transform: uppercase;
            letter-spacing: 2px; width: 100%; transition: 0.3s;
        }
        .btn-grad:hover { filter: brightness(1.2); transform: translateY(-2px); }

        /* DASHBOARD COMPONENTS */
        .dash-wrap { width: 100%; max-width: 1100px; display: flex; flex-direction: column; gap: 30px; }
        .dossier-module { 
            background: rgba(10, 25, 47, 0.6); border: 1px solid rgba(255,255,255,0.05); 
            padding: 40px; border-left: 4px solid var(--accent-cyan); 
            border-radius: 0 12px 12px 0;
        }
        .swot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 25px 0; }
        .swot-item { padding: 25px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.02); }
        
        .summary-header { font-size: 13px; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-cyan); margin-bottom: 15px; display: block; }
        .summary-body { font-size: 16px; color: #cbd5e1; line-height: 1.8; }
        .highlight-text { color: white; font-weight: 700; border-bottom: 1px solid var(--accent-cyan); }

        .rec-table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 14px; }
        .rec-table th { text-align: left; padding: 15px; color: var(--text-dim); border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 11px; text-transform: uppercase; }
        .rec-table td { padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); color: #e2e8f0; }

        /* SCANNER */
        .scanner-container { width: 300px; height: 350px; border: 1px solid var(--accent-cyan); position: relative; overflow: hidden; background: #000; }
        .scan-bar { width: 100%; height: 3px; background: var(--accent-cyan); position: absolute; animation: scan 2.5s infinite ease-in-out; }
        @keyframes scan { 0%, 100% { top: 0; } 50% { top: 100%; } }

        section { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; }
        
        @media print { .no-print { display: none !important; } body { background: white; color: black; } .dossier-module { border: 1px solid #000; color: black; } }
    </style>
</head>
<body>

    <div class="bg-grid"></div>

    <div id="success-message" class="hidden success-toast">
        <i class="fas fa-check-double" style="font-size: 3rem; color: var(--accent-cyan); margin-bottom: 15px;"></i>
        <h2>NODE INITIALIZED</h2>
        <p style="color: var(--text-dim); font-size: 12px; letter-spacing: 1px;">CREDENTIALS ENCRYPTED & SYNCED</p>
    </div>

    <section id="s-landing">
        <h1 style="font-size: clamp(40px, 10vw, 80px); text-align: center; line-height: 0.9; font-weight: 800;">NEURAL<br><span style="color: var(--accent-cyan)">PATHWAY.</span></h1>
        <p style="color: var(--text-dim); margin: 30px 0 50px; text-align: center; max-width: 550px;">Decode your market value using 2026-standard career intelligence metrics.</p>
        <button class="btn-grad" style="max-width: 300px;" onclick="nav('s-signup')">Access Protocol</button>
    </section>

    <section id="s-signup" class="hidden">
        <div class="glass-card">
            <h2 style="margin-bottom: 25px;">Initialize Profile</h2>
            <div class="input-group">
                <input type="text" id="reg-user" class="input-box" placeholder="User Alias">
            </div>
            <div class="input-group">
                <input type="email" id="reg-email" class="input-box" placeholder="Identity Link (Email)">
            </div>
            <div class="input-group">
                <input type="password" id="reg-pass" class="input-box" placeholder="Security Key (8+ characters)">
                <i class="fas fa-eye eye-icon" onclick="togglePass('reg-pass')"></i>
            </div>
            <button class="btn-grad" onclick="handleSignup()">Establish Node</button>
        </div>
    </section>

    <section id="s-login" class="hidden">
        <div class="glass-card">
            <h2 style="margin-bottom: 25px; color: var(--accent-cyan);">Credential Entry</h2>
            <div class="input-group">
                <input type="text" id="log-user" class="input-box" placeholder="Alias">
            </div>
            <div class="input-group">
                <input type="password" id="log-pass" class="input-box" placeholder="Security Key">
            </div>
            <button class="btn-grad" onclick="handleLogin()">Verify Access</button>
        </div>
    </section>

    <section id="s-upload" class="hidden">
        <div class="glass-card" style="max-width: 550px; text-align: center;">
            <h2 style="margin-bottom: 10px;">Dossier Uplink</h2>
            <p style="color: var(--text-dim); margin-bottom: 30px; font-size: 14px;">Upload your professional history for deep-spectrum parsing.</p>
            <div style="border: 2px dashed rgba(0, 204, 255, 0.2); padding: 50px; border-radius: 12px; margin-bottom: 25px;">
                <i class="fas fa-file-invoice" style="font-size: 40px; color: var(--accent-cyan); margin-bottom: 20px;"></i>
                <p id="file-status" style="font-weight: 700;">AWAITING FILE...</p>
                <input type="file" id="real-file" class="hidden" onchange="updateFileLabel()">
                <button class="btn-grad" style="background: rgba(255,255,255,0.05); border: 1px solid var(--accent-cyan); margin-top: 20px; width: auto; padding: 10px 30px;" onclick="document.getElementById('real-file').click()">Browse</button>
            </div>
            <button id="process-btn" class="btn-grad hidden" onclick="startAnalysis()">Run Neural Analysis</button>
        </div>
    </section>

    <section id="s-analysing" class="hidden">
        <div class="scanner-container">
            <div class="scan-bar"></div>
            <div style="padding: 20px; font-family: monospace; font-size: 11px; color: var(--accent-cyan); line-height: 2;">
                > INTERCEPTING PACKETS...<br>> DECONSTRUCTING SEMANTICS...<br>> BENCHMARKING SALARY DELTA...<br>> MAPPING AUTOMATION RISKS...<br>> GENERATING DOSSIER...
            </div>
        </div>
        <h3 style="margin-top: 30px; letter-spacing: 5px; color: var(--accent-cyan);">EXTRACTING INTELLIGENCE</h3>
    </section>

    <section id="s-dashboard" class="hidden">
        <div class="dash-wrap">
            <div style="display: flex; justify-content: space-between; align-items: flex-end;" class="no-print">
                <div>
                    <h1 style="color: var(--accent-cyan); font-size: 35px; letter-spacing: -2px;">STRATEGIC DOSSIER</h1>
                    <p style="color: var(--text-dim); font-size: 12px;">SUBJECT: <span id="node-name" style="color:white; font-weight: 800;"></span> | NODE: 2026.V4</p>
                </div>
                <button class="btn-grad" style="width: auto; padding: 12px 30px; font-size: 12px;" onclick="window.print()">EXPORT PDF</button>
            </div>

            <div class="dossier-module">
                <span class="summary-header">1.0 Executive Trajectory & Market Analysis</span>
                <p class="summary-body">
                    Analysis of your professional graph indicates a <span class="highlight-text">High-Velocity Technical Architect</span> profile, currently outperforming 96% of the global cognitive labor pool. You have successfully navigated the "Implementation Era," but the 2026 market shift toward <span class="highlight-text">Agentic Orchestration</span> has created a critical fork in your career path.
                    <br><br>
                    <strong>Current Positioning:</strong> Your mastery of high-concurrency systems and distributed architecture provides a robust foundation. However, your data footprint suggests you are currently over-leveraged in "Execution Logic" and under-leveraged in "Strategic Governance." In a world where 70% of routine CI/CD and system optimization is handled by autonomous agents, your current role faces <span class="highlight-text">high automation exposure</span> by Q4 2027.
                    <br><br>
                    <strong>Strategic Pivot:</strong> To maintain a non-linear compensation trajectory, you must evolve into a <span class="highlight-text">Guardian of Algorithmic Integrity</span>. This requires moving beyond code-level contribution and into the oversight of mixed human-AI workforces, predictive FinOps, and decentralized compute governance.
                </p>
            </div>

            <div class="dossier-module">
                <span class="summary-header">2.0 Deep-Spectrum SWOT Matrix</span>
                <div class="swot-grid">
                    <div class="swot-item">
                        <strong style="color: var(--success-green); font-size: 13px;"><i class="fas fa-shield-alt"></i> STRENGTHS</strong>
                        <p style="font-size: 12px; margin-top: 10px; color: var(--text-dim);">
                            <strong>Technical Resilience:</strong> Exceptional ability to architect anti-fragile systems.<br>
                            <strong>Cognitive Load Capacity:</strong> High efficiency in synthesizing multi-modal data streams.
                        </p>
                    </div>
                    <div class="swot-item">
                        <strong style="color: var(--error-red); font-size: 13px;"><i class="fas fa-exclamation-circle"></i> WEAKNESSES</strong>
                        <p style="font-size: 12px; margin-top: 10px; color: var(--text-dim);">
                            <strong>Governance Gap:</strong> Limited exposure to AI ethics frameworks and predictive resource modeling.<br>
                            <strong>Network Siloing:</strong> Professional graph is heavily weighted toward execution peers.
                        </p>
                    </div>
                    <div class="swot-item">
                        <strong style="color: var(--accent-cyan); font-size: 13px;"><i class="fas fa-chart-line"></i> OPPORTUNITIES</strong>
                        <p style="font-size: 12px; margin-top: 10px; color: var(--text-dim);">
                            <strong>Vector-Ops Expansion:</strong> Rapid growth in roles requiring LLM infrastructure oversight.<br>
                            <strong>Agent Management:</strong> Leading the transition from DevOps to Agentic-Ops.
                        </p>
                    </div>
                    <div class="swot-item">
                        <strong style="color: #ffcc00; font-size: 13px;"><i class="fas fa-biohazard"></i> RISKS</strong>
                        <p style="font-size: 12px; margin-top: 10px; color: var(--text-dim);">
                            <strong>Agentic Displacement:</strong> Mid-level architectural tasks being subsumed by AI-agents.<br>
                            <strong>Global Compression:</strong> Wage pressure from decentralized, AI-augmented labor pools.
                        </p>
                    </div>
                </div>
            </div>

            <div class="dossier-module" style="border-left-color: var(--success-green);">
                <span class="summary-header" style="color: var(--success-green);">3.0 Strategic Career Nodes (2026-2028)</span>
                <table class="rec-table">
                    <thead>
                        <tr><th>Target Position</th><th>Market Fit</th><th>Est. Comp (TC)</th><th>Critical Upskill</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><strong>Agentic Ops Director</strong></td><td style="color: var(--success-green);">98% Match</td><td>$450k - $620k</td><td>Multi-Agent Flow</td></tr>
                        <tr><td><strong>Integrity Architect</strong></td><td style="color: var(--success-green);">91% Match</td><td>$390k - $510k</td><td>Neural Auditing</td></tr>
                        <tr><td><strong>Spatial Compute Lead</strong></td><td style="color: var(--accent-cyan);">84% Match</td><td>$410k - $580k</td><td>Edge-Latency Opt.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <button class="btn-grad no-print" style="margin-top: 50px; width: auto; background: transparent; border: 1px solid var(--accent-cyan); padding: 10px 40px;" onclick="location.reload()">Reset Session</button>
    </section>

    <script>
        let userData = { name: "ANON" };

        function nav(id) {
            document.querySelectorAll('section').forEach(s => s.classList.add('hidden'));
            document.getElementById(id).classList.remove('hidden');
            window.scrollTo(0,0);
        }

        function togglePass(id) {
            const f = document.getElementById(id);
            f.type = f.type === "password" ? "text" : "password";
        }

        function handleSignup() {
            const user = document.getElementById('reg-user').value;
            if(!user) return alert("Enter alias");
            userData.name = user;
            document.getElementById('success-message').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('success-message').classList.add('hidden');
                nav('s-login');
            }, 2000);
        }

        function handleLogin() {
            nav('s-upload');
        }

        function updateFileLabel() {
            const f = document.getElementById('real-file').files[0];
            if(f) {
                document.getElementById('file-status').innerText = "LINKED: " + f.name.toUpperCase();
                document.getElementById('process-btn').classList.remove('hidden');
            }
        }

        function startAnalysis() {
            document.getElementById('node-name').innerText = userData.name.toUpperCase();
            nav('s-analysing');
            setTimeout(() => nav('s-dashboard'), 3500);
        }
    </script>
</body>
</html>
